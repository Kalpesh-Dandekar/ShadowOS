{
  "name": "@shadowos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npm run prisma:generate",
    "lint": "eslint src tests prisma prisma.config.js",
    "test:rbac": "node --test --test-concurrency=1 tests/rbac.integration.test.js",
    "test:role-enrollment": "node --test --test-concurrency=1 tests/role-enrollment.integration.test.js",
    "test:requests": "node --test --test-concurrency=1 tests/request.integration.test.js",
    "test:planner": "node --test --test-concurrency=1 tests/planner.integration.test.js",
    "test:simulation": "node --test --test-concurrency=1 tests/simulation.integration.test.js",
    "test:risk": "node --test --test-concurrency=1 tests/risk.integration.test.js",
    "test:policy": "node --test --test-concurrency=1 tests/policy.integration.test.js",
    "test:approval": "node --test --test-concurrency=1 tests/approval.integration.test.js",
    "test:approval-scenario": "node --test --test-concurrency=1 tests/approval-scenario.integration.test.js",
    "test:execution": "node --test --test-concurrency=1 tests/execution.integration.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "prisma": "^7.9.1"
  }
}
