generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  SUBMITTED
  PLANNING
  PLANNED
  FAILED
  CANCELLED
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum PlannerProviderType {
  SIMULATION
}

enum PlanStatus {
  GENERATED
  INVALID
}

enum PlanActionType {
  QUERY_RESOURCE
  VALIDATE_SCOPE
  CREATE_RESOURCE
  UPDATE_RESOURCE
  ARCHIVE_RESOURCE
  DELETE_RESOURCE
}

enum PlanResourceType {
  INVOICE
  CUSTOMER_ACCOUNT
  USER_ACCOUNT
  FILE
  RECORD
}

enum SimulationProviderType {
  SYNTHETIC
}

enum SimulationStatus {
  COMPLETED
  FAILED
}

enum SimulationEffectType {
  ARCHIVE_RESOURCE
  DELETE_RESOURCE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskSourceType {
  REQUEST
  PLAN
  SIMULATION
}

enum PolicyDecision {
  ALLOW
  REQUIRE_APPROVAL
  BLOCK
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExecutionProviderType {
  SYNTHETIC
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ExecutionActionStatus {
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum AuditEventType {
  EXECUTION_STARTED
  EXECUTION_COMPLETED
  EXECUTION_FAILED
  ROLLBACK_STARTED
  ROLLBACK_COMPLETED
  ROLLBACK_FAILED
}

enum RollbackStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  email                 String            @unique
  passwordHash          String
  role                  Role              @default(EMPLOYEE)
  status                UserStatus        @default(ACTIVE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  submittedRoleRequests RoleRequest[]     @relation("SubmittedRoleRequests")
  reviewedRoleRequests  RoleRequest[]     @relation("ReviewedRoleRequests")
  requests              Request[]
  requestedApprovals    ApprovalRequest[] @relation("RequestedApprovals")
  reviewedApprovals     ApprovalRequest[] @relation("ReviewedApprovals")
  executionRuns         ExecutionRun[]     @relation("ExecutionActors")
  auditEvents           AuditEvent[]       @relation("AuditActors")
  rollbackRuns          RollbackRun[]      @relation("RollbackActors")
}

model Request {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  prompt        String
  status        RequestStatus  @default(SUBMITTED)
  environment   Environment
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionPlan ExecutionPlan?
  executionRun  ExecutionRun?
  auditEvents   AuditEvent[]

  @@index([userId, createdAt])
}

model ExecutionPlan {
  id            String              @id @default(uuid()) @db.Uuid
  requestId     String              @unique @db.Uuid
  provider      PlannerProviderType
  summary       String
  status        PlanStatus          @default(GENERATED)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  request       Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actions       PlanAction[]
  simulationRun SimulationRun?
  executionRun  ExecutionRun?
}

model PlanAction {
  id                String             @id @default(uuid()) @db.Uuid
  planId            String             @db.Uuid
  position          Int
  type              PlanActionType
  resourceType      PlanResourceType
  description       String
  target            Json
  destructive       Boolean            @default(false)
  reversible        Boolean            @default(true)
  estimatedScope    String?
  reason            String
  createdAt         DateTime           @default(now())
  plan              ExecutionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  simulationEffects SimulationEffect[]
  executionResults  ExecutionActionResult[]

  @@unique([planId, position])
  @@index([planId])
}

model SimulationRun {
  id                     String                 @id @default(uuid()) @db.Uuid
  planId                 String                 @unique @db.Uuid
  provider               SimulationProviderType
  status                 SimulationStatus       @default(COMPLETED)
  totalResourcesExamined Int
  matchedResources       Int
  affectedResources      Int
  dependencyObservations Int
  summary                String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  plan                   ExecutionPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  effects                SimulationEffect[]
  riskAssessment         RiskAssessment?
  executionRun           ExecutionRun?
}

model RiskAssessment {
  id               String            @id @default(uuid()) @db.Uuid
  simulationRunId  String            @unique @db.Uuid
  score            Int
  level            RiskLevel
  summary          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  simulationRun    SimulationRun     @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  factors          RiskFactor[]
  policyEvaluation PolicyEvaluation?
  executionRun     ExecutionRun?
}

model PolicyEvaluation {
  id                 String           @id @default(uuid()) @db.Uuid
  riskAssessmentId   String           @unique @db.Uuid
  decision           PolicyDecision
  summary            String
  evaluatedRuleCount Int
  matchedRuleCount   Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  riskAssessment     RiskAssessment   @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  matches            PolicyMatch[]
  approvalRequest    ApprovalRequest?
  executionRun       ExecutionRun?
}

model ApprovalRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  policyEvaluationId String           @unique @db.Uuid
  requesterId        String           @db.Uuid
  reviewerId         String?          @db.Uuid
  status             ApprovalStatus   @default(PENDING)
  reviewComment      String?
  requestedAt        DateTime         @default(now())
  decidedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  policyEvaluation   PolicyEvaluation @relation(fields: [policyEvaluationId], references: [id], onDelete: Cascade)
  requester          User             @relation("RequestedApprovals", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer           User?            @relation("ReviewedApprovals", fields: [reviewerId], references: [id], onDelete: SetNull)
  executionRun       ExecutionRun?

  @@index([status, requestedAt])
  @@index([requesterId])
  @@index([reviewerId])
}

model PolicyMatch {
  id                 String           @id @default(uuid()) @db.Uuid
  policyEvaluationId String           @db.Uuid
  ruleKey            String
  ruleName           String
  decision           PolicyDecision
  priority           Int
  observedFacts      Json
  explanation        String
  createdAt          DateTime         @default(now())
  policyEvaluation   PolicyEvaluation @relation(fields: [policyEvaluationId], references: [id], onDelete: Cascade)

  @@unique([policyEvaluationId, ruleKey])
  @@index([policyEvaluationId])
}

model RiskFactor {
  id               String         @id @default(uuid()) @db.Uuid
  riskAssessmentId String         @db.Uuid
  key              String
  label            String
  observedValue    Json
  normalizedScore  Int
  weight           Float
  contribution     Float
  explanation      String
  sourceType       RiskSourceType
  createdAt        DateTime       @default(now())
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)

  @@unique([riskAssessmentId, key])
  @@index([riskAssessmentId])
}

model SimulationEffect {
  id              String               @id @default(uuid()) @db.Uuid
  simulationRunId String               @db.Uuid
  planActionId    String               @db.Uuid
  resourceKey     String
  resourceType    PlanResourceType
  effectType      SimulationEffectType
  beforeState     Json
  afterState      Json
  changed         Boolean              @default(true)
  createdAt       DateTime             @default(now())
  simulationRun   SimulationRun        @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  planAction      PlanAction           @relation(fields: [planActionId], references: [id], onDelete: Cascade)

  @@unique([simulationRunId, planActionId, resourceKey])
  @@index([simulationRunId])
  @@index([planActionId])
}

model RoleRequest {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  requestedRole Role
  status        RoleRequestStatus @default(PENDING)
  reviewedById  String?           @db.Uuid
  reviewComment String?
  createdAt     DateTime          @default(now())
  reviewedAt    DateTime?
  updatedAt     DateTime          @updatedAt
  user          User              @relation("SubmittedRoleRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("ReviewedRoleRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, requestedRole])
  @@index([userId, status])
}

model ExecutionRun {
  id                 String                @id @default(uuid()) @db.Uuid
  requestId          String                @unique @db.Uuid
  planId             String                @unique @db.Uuid
  simulationRunId    String                @unique @db.Uuid
  riskAssessmentId   String                @unique @db.Uuid
  policyEvaluationId String                @unique @db.Uuid
  approvalRequestId  String?               @unique @db.Uuid
  actorUserId        String                @db.Uuid
  provider           ExecutionProviderType @default(SYNTHETIC)
  status             ExecutionStatus       @default(PENDING)
  summary            String
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  rolledBackAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  request            Request               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  plan               ExecutionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  simulationRun      SimulationRun          @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  riskAssessment     RiskAssessment         @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  policyEvaluation   PolicyEvaluation       @relation(fields: [policyEvaluationId], references: [id], onDelete: Cascade)
  approvalRequest    ApprovalRequest?       @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  actor              User                   @relation("ExecutionActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  actionResults      ExecutionActionResult[]
  rollbackRun        RollbackRun?

  @@index([actorUserId, createdAt])
  @@index([status])
}

model ExecutionActionResult {
  id             String                @id @default(uuid()) @db.Uuid
  executionRunId String                @db.Uuid
  planActionId   String                @db.Uuid
  position       Int
  actionType     PlanActionType
  resourceType   PlanResourceType
  status         ExecutionActionStatus @default(COMPLETED)
  matchedCount   Int
  affectedCount  Int
  reversible     Boolean
  summary        String
  beforeJson     Json
  afterJson      Json
  createdAt      DateTime              @default(now())
  executionRun   ExecutionRun          @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  planAction     PlanAction             @relation(fields: [planActionId], references: [id], onDelete: Restrict)
  rollbackResults RollbackActionResult[]

  @@unique([executionRunId, planActionId])
  @@unique([executionRunId, position])
  @@index([planActionId])
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @db.Uuid
  actorUserId String?        @db.Uuid
  eventType   AuditEventType
  sourceType  String
  sourceId    String?        @db.Uuid
  message     String
  metadataJson Json?
  createdAt   DateTime       @default(now())
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User?          @relation("AuditActors", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([eventType, createdAt])
}

model RollbackRun {
  id             String         @id @default(uuid()) @db.Uuid
  executionRunId String         @unique @db.Uuid
  actorUserId    String         @db.Uuid
  status         RollbackStatus @default(RUNNING)
  summary        String
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  executionRun   ExecutionRun   @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  actor          User           @relation("RollbackActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  actionResults  RollbackActionResult[]

  @@index([actorUserId, createdAt])
}

model RollbackActionResult {
  id                      String                @id @default(uuid()) @db.Uuid
  rollbackRunId           String                @db.Uuid
  executionActionResultId String                @db.Uuid
  position                Int
  status                  ExecutionActionStatus @default(ROLLED_BACK)
  restoredJson            Json
  summary                 String
  createdAt               DateTime              @default(now())
  rollbackRun             RollbackRun           @relation(fields: [rollbackRunId], references: [id], onDelete: Cascade)
  executionActionResult   ExecutionActionResult @relation(fields: [executionActionResultId], references: [id], onDelete: Restrict)

  @@unique([rollbackRunId, executionActionResultId])
  @@unique([rollbackRunId, position])
}
